{
  "name": "beanyik",
  "productName": "BeanyIK",
  "version": "1.0.1",
  "description": "Drag & drop robot kinematics builder with DH parameters, custom matrices and forward & inverse kinematics",
  "main": "main.js",
  "private": true,
  "author": "GreenyBeany",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "vendor": "node scripts/vendor.js",
    "test": "node scripts/selftest.mjs",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "three": "0.170.0"
  },
  "build": {
    "appId": "dev.greenybeany.beanyik",
    "productName": "BeanyIK",
    "copyright": "Copyright © 2026 GreenyBeany",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "update-checker.js",
      "icon.png",
      "LICENSE",
      "TERMS.md",
      "CREDITS.md",
      "renderer/**/*"
    ],
    "icon": "build/icon.ico",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build/license.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BeanyIK",
      "artifactName": "BeanyIK-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "BeanyIK-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "icon.png"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  },
  "homepage": "https://github.com/greenythebeany/BeanyIK",
  "repository": {
    "type": "git",
    "url": "https://github.com/greenythebeany/BeanyIK.git"
  }
}
