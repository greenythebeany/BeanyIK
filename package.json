{
  "name": "beanyik",
  "productName": "BeanyIK",
  "version": "1.2.1",
  "description": "Drag & drop robot kinematics builder with DH parameters, custom matrices and forward & inverse kinematics",
  "main": "main.js",
  "private": true,
  "author": "GreenyBeany",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "vendor": "node scripts/vendor.js",
    "test": "node scripts/selftest.mjs && node scripts/demo-check.mjs && node scripts/flick-check.mjs && node scripts/site-arm-check.mjs",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never -c.directories.buildResources=build/mac"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^31.3.1",
    "electron-builder": "^26.15.3",
    "three": "0.170.0"
  },
  "build": {
    "appId": "dev.greenybeany.beanyik",
    "productName": "BeanyIK",
    "copyright": "Copyright © 2026 GreenyBeany",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "icon.png",
      "LICENSE",
      "TERMS.md",
      "CREDITS.md",
      "renderer/**/*",
      "TERMS.sk.md"
    ],
    "icon": "build/icon.ico",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BeanyIK",
      "artifactName": "BeanyIK-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "sk_SK"
      ],
      "displayLanguageSelector": true,
      "unicode": true
    },
    "portable": {
      "artifactName": "BeanyIK-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "greenythebeany",
      "repo": "BeanyIK",
      "releaseType": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "BeanyIK-${version}-mac-${arch}.${ext}",
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "BeanyIK ${version}",
      "artifactName": "BeanyIK-${version}-mac-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  },
  "homepage": "https://github.com/greenythebeany/BeanyIK",
  "repository": {
    "type": "git",
    "url": "https://github.com/greenythebeany/BeanyIK.git"
  }
}
